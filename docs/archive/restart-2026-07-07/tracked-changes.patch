+def _hero_action_kind(row: str) -> str | None:
+    if " folds" in row:
+        return "fold"
+    if " calls " in row:
+        return "call"
+    if " raises " in row:
+        return "jam" if "all-in" in row or "all in" in row else "raise"
+    return None
