+def _extract_preflop_line_features(block: list[str]) -> dict[str, Any]:
+    in_preflop = False
+    prior_raise_count = 0
+    hero_first_action: str | None = None
+    hero_opened = False
+    hero_made_3bet = False
+    open_faced_3bet = False
+    open_response_to_3bet: str | None = None
+    three_bet_faced_4bet = False
+    three_bet_response_to_4bet: str | None = None
+
+    for row in block:
+        if row == "*** HOLE CARDS ***":
+            in_preflop = True
+            continue
+        if not in_preflop:
+            continue
+        if row.startswith("*** FLOP ***") or row.startswith("*** SHOWDOWN ***") or row.startswith("*** SUMMARY ***"):
+            break
+        if ":" not in row:
+            continue
+
+        actor, _ = row.split(":", 1)
+        action_kind = _hero_action_kind(row) if actor == "Hero" else None
+
+        if actor == "Hero":
+            if hero_first_action is None:
+                hero_first_action = action_kind
+                if action_kind in {"raise", "jam"} and prior_raise_count == 0:
+                    hero_opened = True
+                elif action_kind in {"raise", "jam"} and prior_raise_count == 1:
+                    hero_made_3bet = True
+            elif open_faced_3bet and open_response_to_3bet is None:
+                open_response_to_3bet = action_kind
+            elif three_bet_faced_4bet and three_bet_response_to_4bet is None:
+                three_bet_response_to_4bet = action_kind
+            continue
+
+        if " raises " in row:
+            prior_raise_count += 1
+            if hero_opened and not open_faced_3bet:
+                open_faced_3bet = True
+            elif hero_made_3bet and not three_bet_faced_4bet:
+                three_bet_faced_4bet = True
+
+    return {
+        "open_faced_3bet": open_faced_3bet,
+        "open_response_to_3bet": open_response_to_3bet,
+        "three_bet_faced_4bet": three_bet_faced_4bet,
+        "three_bet_response_to_4bet": three_bet_response_to_4bet,
+    }
+
